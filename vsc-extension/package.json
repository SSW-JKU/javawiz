{
  "name": "javawiz",
  "displayName": "JavaWiz",
  "description": "Visualize the execution of your Java programs",
  "version": "2.4.1",
  "publisher": "ssw-jku",
  "engines": {
    "vscode": "^1.87.0"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "categories": [
    "Debuggers",
    "Visualization",
    "Education",
    "Other"
  ],
  "keywords": [
    "Visual / Graphical Debugger",
    "Trace-based Time-Travel Debugger",
    "Software Education and Visualization",
    "Visual Teaching",
    "Program Comprehension and Understanding"
  ],
  "homepage": "https://ssw.jku.at/Research/Projects/JavaWiz/",
  "bugs": {
    "url": "https://ssw.jku.at/General/Staff/Weninger/",
    "email": "markus.weninger@jku.at"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SSW-JKU/javawiz"
  },
  "icon": "img/wizard-hat.png",
  "galleryBanner": {
    "color": "#163150",
    "theme": "dark"
  },
  "preview": false,
  "pricing": "Free",
  "activationEvents": [
    "onCommand:enableIntelliSense",
    "onCommand:disableIntelliSense",
    "onLanguage:java",
    "onWebviewPanel:javawiz"
  ],
  "main": "./out/vsc-extension/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "javawiz.start",
        "title": "Debug with JavaWiz",
        "category": "JavaWiz"
      },
      {
        "command": "javawiz.enableJavaFeatures",
        "title": "Enable Advanced Java Support",
        "category": "JavaWiz"
      },
      {
        "command": "javawiz.disableJavaFeatures",
        "title": "Disable Advanced Java Support",
        "category": "JavaWiz"
      },
      {
        "command": "javawiz.createIn",
        "title": "Create In.java",
        "category": "JavaWiz"
      },
      {
        "command": "javawiz.createOut",
        "title": "Create Out.java",
        "category": "JavaWiz"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == java",
          "command": "javawiz.start"
        },
        {
          "when": "resourceLangId == java",
          "command": "javawiz.enableJavaFeatures"
        },
        {
          "when": "resourceLangId == java",
          "command": "javawiz.disableJavaFeatures"
        }
      ],
      "editor/title/run": [
        {
          "when": "resourceLangId == java",
          "command": "javawiz.start"
        }
      ],
      "explorer/context": [
        {
          "when": "explorerViewletVisible",
          "command": "javawiz.createIn"
        },
        {
          "when": "explorerViewletVisible",
          "command": "javawiz.createOut"
        }
      ]
    },
    "keybindings": [
      {
        "when": "resourceLangId == java",
        "command": "javawiz.start",
        "key": "ctrl+shift+j"
      }
    ],
    "configuration": {
      "title": "JavaWiz",
      "properties": {
        "javawiz.excludeFromSteppingPatterns": {
          "type": "array",
          "default": [
            "java.*",
            "javax.*",
            "javafx.*",
            "sun.*",
            "com.sun.*",
            "jdk.*",
            "*.In",
            "*.Out",
            "*.Rand",
            "In",
            "Out",
            "Rand"
          ],
          "description": "Class patterns for classes that JavaWiz does not step into and does not track (no condition or array-access tracking). The default list is the same as in the browser and IntelliJ versions of JavaWiz. Changing this setting might break functionality."
        },
        "javawiz.heapTraversalStopPatterns": {
          "type": "array",
          "default": [
            "java.*",
            "javax.*",
            "javafx.*",
            "sun.*",
            "com.sun.*",
            "jdk.*",
            "*.In",
            "*.Out",
            "*.Rand",
            "In",
            "Out",
            "Rand"
          ],
          "description": "Class patterns for classes whose fields JavaWiz does not show, such as JDK classes. Classes matching the data structure patterns are still shown. The default list is the same as in the browser and IntelliJ versions of JavaWiz. Changing this setting might break functionality."
        },
        "javawiz.dataStructurePatterns": {
          "type": "array",
          "default": [
            "java.util.ArrayList",
            "java.util.LinkedList",
            "java.util.Vector",
            "java.util.Stack",
            "java.util.HashSet",
            "java.util.LinkedHashSet",
            "java.util.TreeSet",
            "java.util.BitSet",
            "java.util.EnumSet",
            "java.util.HashMap",
            "java.util.LinkedHashMap",
            "java.util.TreeMap",
            "java.util.Hashtable",
            "java.util.Properties",
            "java.util.WeakHashMap",
            "java.util.IdentityHashMap",
            "java.util.EnumMap",
            "java.util.PriorityQueue",
            "java.util.ArrayDeque",
            "java.util.concurrent.ConcurrentHashMap",
            "java.util.concurrent.CopyOnWriteArrayList",
            "java.util.concurrent.CopyOnWriteArraySet",
            "java.util.concurrent.ConcurrentSkipListMap",
            "java.util.concurrent.ConcurrentSkipListSet",
            "java.util.concurrent.ConcurrentLinkedQueue",
            "java.util.concurrent.ConcurrentLinkedDeque",
            "java.util.concurrent.ArrayBlockingQueue",
            "java.util.concurrent.LinkedBlockingQueue",
            "java.util.concurrent.LinkedBlockingDeque",
            "java.util.concurrent.PriorityBlockingQueue",
            "java.util.concurrent.DelayQueue",
            "java.util.concurrent.SynchronousQueue",
            "java.util.concurrent.LinkedTransferQueue",
            "java.util.Arrays$ArrayList",
            "java.util.Collections$SingletonList",
            "java.util.Collections$SingletonSet",
            "java.util.Collections$SingletonMap",
            "java.util.Collections$EmptyList",
            "java.util.Collections$EmptySet",
            "java.util.Collections$EmptyMap",
            "java.util.ImmutableCollections$List12",
            "java.util.ImmutableCollections$ListN",
            "java.util.ImmutableCollections$Set12",
            "java.util.ImmutableCollections$SetN",
            "java.util.ImmutableCollections$Map1",
            "java.util.ImmutableCollections$MapN",
            "java.util.concurrent.atomic.AtomicInteger",
            "java.util.concurrent.atomic.AtomicLong",
            "java.util.concurrent.atomic.AtomicBoolean",
            "java.util.concurrent.atomic.AtomicReference"
          ],
          "description": "Class patterns for Java data structures, such as ArrayList or HashMap, whose contents JavaWiz shows although they match the heap traversal stop patterns. The default list is the same as in the browser and IntelliJ versions of JavaWiz."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "lint": "eslint",
    "test": "npm run compile && node --test out/vsc-extension/src/HiddenPath.test.js out/vsc-extension/src/JavaRuntime.test.js out/vsc-extension/src/ExtensionModeUrl.test.js",
    "watch": "node watch.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/http-server": "^0.12.1",
    "@types/lodash": "^4.17.0",
    "@types/node": "^18.19.130",
    "@types/vscode": "1.87.0",
    "@types/websocket": "^1.0.5",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2"
  },
  "dependencies": {
    "child-process": "^1.0.2",
    "globals": "^17.7.0",
    "http-server": "^14.1.1",
    "lodash": "^4.17.21",
    "tree-kill": "^1.2.2",
    "websocket": "^1.0.34"
  },
  "extensionDependencies": [
    "redhat.java",
    "vscjava.vscode-java-debug"
  ]
}
